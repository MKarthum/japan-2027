  "transport": [
    {
      "icon": "🚆",
      "title": "Shinkansen mellom byene",
      "short": "Dette blir ryggraden i reisen.",
      "body": "Tokyo → Kyoto → Himeji → Hiroshima → Shin-Osaka ligger på Tokaido/Sanyo-korridoren. SmartEX-nettsiden lar oss reservere seter og bruke QR-billett. Vi trenger ikke planlegge innenriksfly på dagens rute.",
      "links": [
        {
          "label": "SmartEX",
