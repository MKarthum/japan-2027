  "placeWords": [
    {
      "term": "torii",
      "meaning": "Porten ved en shinto-helligdom. Fushimi Inari og Miyajima gjør dette ordet lett å huske."
    },
    {
      "term": "-ji / -dera",
      "meaning": "Buddhistisk tempel. Tōdai-ji, Kinkaku-ji og Kiyomizu-dera."
    },
    {
      "term": "jinja / taisha",
      "meaning": "Shinto-helligdom. Taisha brukes om særlig viktige helligdommer, som Fushimi Inari Taisha."
    },
    {
      "term": "-jō",
      "meaning": "Slott. Himeji-jō betyr Himeji Castle."
    },
